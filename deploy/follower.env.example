# /etc/filet/followers/<id>.env — 單一 follower 引擎設定（權限 640，filet-engine 可讀）
# 注意：FILET_STATE_DIR / FILET_KEYSTORE / FILET_KEYS_DIR 由 systemd unit 注入，不放這裡。
# agent key 走 EnvFileKeyStore：/etc/filet/keys/<SPARK_ACCOUNT_ID>/agent.key（600）
#
# ⚠️⚠️ 2026-07-19：本範本刻意出貨「安全值」，不是「常用值」。
# 這個檔設定的是**會實際下單的引擎**。本範本原本出貨 SPARK_NETWORK=mainnet ＋
# COPY_LIVE_TRADING=true，等於讓「複製範本後忘記改」的人直接拿真錢在主網跟單——
# 而專案紅線寫明「live_trading 預設 False，任何主網寫入是人工決策，不得自動開啟」。
# 範本把那條紅線的預設值反轉了，故改為出貨安全值。
#
# 下面兩個值要改成主網／實盤，是**動真錢的人工決策**：
#   - 改之前確認 leader、本金、回撤上限、kill switch 都已就緒
#   - 改之後第一輪務必人工盯著（journalctl -fu filet-follower@<id>）

SPARK_NETWORK=testnet
COPY_LIVE_TRADING=false

# ↓ 以下沒有安全預設值，必須逐一填寫（留著佔位符會讓引擎 fail-fast 拒絕啟動）
SPARK_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
SPARK_USER_ADDR=REPLACE_WITH_USER_ADDRESS
SPARK_BUILDER_ADDR=REPLACE_WITH_BUILDER_ADDRESS

# ↓ 風險參數。COPY_ALLOCATED_CAPITAL 是實際投入的本金上限，
#   請按該客戶實際授權的金額填寫，不要沿用範例數字。
COPY_ALLOCATED_CAPITAL=REPLACE_WITH_ALLOCATED_CAPITAL
COPY_MAX_DRAWDOWN_PCT=0.20

# ↓ 通知管道。未設定時引擎仍可跑，但 kill switch 觸發等 critical 告警將無人收到。
COPY_TG_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
COPY_TG_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID

# ↓ 校正行為（選配；2026-07-27 主網 dust 事故後開始在生產使用，事故詳見
#   docs/superpowers/research/2026-07-28-min-notional-dust-and-scale-drift.md）
#   COPY_SIZE_TOLERANCE：部位偏離超過此比例才校正（引擎預設 0.02）。生產現值 0.08——
#     吃掉波動度 weight 與 leader 出入金造成的常態 scale 漂移，避免 <$10 殭屍校正與
#     高頻 churn。⚠️ 同一參數也管掛單鏡像的 size 比對（放寬＝掛單 size 容許同幅漂移）。
#   COPY_CAPITAL_UTILIZATION：本金使用率（引擎預設 1.0）。生產現值 0.9——leader 網格
#     跑在 ~99% 保證金占用，1.0 等比鏡像＝零餘裕，任何損耗都會 perpMarginRejected。
#COPY_SIZE_TOLERANCE=0.08
#COPY_CAPITAL_UTILIZATION=0.9
