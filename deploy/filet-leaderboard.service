[Unit]
Description=Filet daily leaderboard snapshots (global top-N + leader watchlist, read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=filet-api
Group=filet-api
WorkingDirectory=/opt/filet/spark
# 2026-07-19：此處 mainnet 是**刻意的例外**，即使部署在 testnet 機器上也不要改。
# 理由：本服務只讀 HL 公開統計（唯讀，不下單），而 testnet 的 leader 統計無意義——
# 改成 testnet 會讓績效資料變成垃圾，且因為仍有資料落地而不會有人發現。
# 副作用：這台機器並非完全與主網隔離。評估隔離性時要把這兩個 timer 算進去。
Environment=SPARK_NETWORK=mainnet
Environment=FILET_DATA_DIR=/var/lib/filet-api
# ⭐ 抓取對象的**單一來源＝leader 白名單**（與 filet-follower@.service 同一個檔）。
# 白名單新增 leader → 本 timer 自動涵蓋，不必再同步任何 env；漏設 env 導致目錄頁
# 永遠 null 統計且零告警的缺口就是這樣關掉的。filet-api 對這個檔唯讀（RUNBOOK §5.5）。
Environment=FILET_LEADERS_PATH=/opt/filet/spark/var/filet/leaders.json
# 選配：白名單**之外**的額外研究對象（逗號分隔）。與白名單取聯集，不是取代它。
#Environment=FILET_LEADER_WATCHLIST=0x...,0x...
# 全站快照 best-effort（ExecStart 前綴 "-"）：stats-data 端點未進官方文件、schema
# 可能無預告變動——它掛掉不擋 watchlist 快照（定案 11）。
ExecStart=-/opt/filet/spark/.venv/bin/python -m scripts.leaderboard_snapshot
ExecStart=/opt/filet/spark/.venv/bin/python -m scripts.watchlist_snapshot
StateDirectory=filet-api
ReadWritePaths=/var/lib/filet-api
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
