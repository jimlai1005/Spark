[Unit]
Description=Filet public API (SIWE onboarding backend, localhost only, behind reverse proxy)
After=network.target filet-keysvc.service
Wants=filet-keysvc.service

[Service]
Type=simple
User=filet-api
Group=filet-api
WorkingDirectory=/opt/filet/spark
# ⚠️ 安全關鍵：不得出貨具體值。此檔會覆蓋 /etc/systemd/system/ 的同名檔，
# 若這裡硬編 mainnet，一次照 RUNBOOK 的重新部署就會把 testnet 機器翻上主網。
# 未填時 config.from_env 會因 `network not in API_URLS` 拒絕啟動（fail-closed）。
Environment=FILET_API_NETWORK=REPLACE_WITH_NETWORK
Environment=FILET_BUILDER_ADDR=REPLACE_WITH_BUILDER_ADDRESS
Environment=FILET_SIWE_DOMAIN=REPLACE_WITH_DASHBOARD_DOMAIN
Environment=FILET_SIWE_URI=REPLACE_WITH_DASHBOARD_URI
Environment=FILET_API_DB=/var/lib/filet-api/api.db
Environment=FILET_KEYSVC_SOCK=/run/filet/keysvc.sock
Environment=FILET_PENDING_PATH=/var/lib/filet-api/pending.json
# ⭐ 客戶簽章換 leader 記錄的**專屬交換目錄**（API 寫、引擎讀）。必須與
# filet-follower@.service 的同名變數逐字元相同——漏設一邊會拒絕啟動（刻意無預設值），
# 設成不同值則由 RUNBOOK §5.5.1 的驗收指令與日報的對帳告警接住。
# 目錄本身是 filet-api:filet-engine 0750，由 RUNBOOK §5.5.1 手動建立（不由服務建）：
# 服務建的話會是 filet-api:filet-api 0755，引擎讀不到而 other 讀得到，兩個方向都錯。
Environment=FILET_EXCHANGE_DIR=/var/lib/filet-exchange
# ⭐⭐ per-follower 引擎狀態根的**基底**。必須讓 `<此值>/<account_id>` 逐字元等於
# filet-follower@.service 的 `FILET_STATE_DIR=/opt/filet/state/%i`（`%i` ＝ account_id）
# ——兩個 unit 對同一條路徑各推導一次，沒有共同的仲裁者。刻意無預設值（漏設即拒絕
# 啟動）：舊版的隱含預設會讓設錯的症狀變成靜默的——API 去看一個引擎沒在寫的目錄，
# 每個 follower 的狀態根都 `absent`，而面板曾把 absent 讀成「kill switch 未觸發」，
# 等於在引擎已熔斷、部位已被平掉的當下報告一切正常。驗收指令見 RUNBOOK §5.5.2。
Environment=FILET_STATE_BASE=/opt/filet/state
# ⭐⭐⭐ 策劃 leader 白名單（客戶**能選誰**的唯一合法來源）。同一條路徑有**五個**
# 消費端：本 unit、filet-follower@（引擎每輪二次驗證）、filet-leaderboard 與
# filet-perf-series（快照抓誰）、以及人工 activate CLI。五個值必須逐字元相同。
# ⚠️ 2026-07-20 之前本 unit **根本沒有宣告這一行**，而它仍能正確運作——因為程式有個
# 隱含預設錨在 repo 根，而 WorkingDirectory 恰好也是 repo 根。那是巧合不是強制：
# 白名單一搬家（或 WorkingDirectory 一改），API 與引擎就讀不同的白名單，而錯的方向是
# fail-open——引擎那份撤銷了某個 leader，目錄頁仍列著他、客戶仍選得到。預設值已移除，
# 漏設即拒絕啟動（require_leaders_path）。驗收見 RUNBOOK §5.7 驗收 4。
Environment=FILET_LEADERS_PATH=/opt/filet/spark/var/filet/leaders.json
# ⭐ I-27（2026-09-02）：北極星／路由量 basis 讀的歷史序列檔——必須與
# filet-daily-report.service 的同名變數逐字元相同（日報寫、API 只讀；API 不需要
# ReadWritePaths，ProtectSystem=strict 下讀取不受限）。值不同會讓 API 讀到日報從未
# 寫過的檔，首頁路由量卡在播種值卻零錯誤（事故 I-27，見 RUNBOOK §5.8a）。
Environment=FILET_ACCRUED_HISTORY_PATH=/opt/filet/spark/var/filet/reports/accrued_history.jsonl
# ⭐ I-17 explore 磁碟快取（2026-09-02 追加為必填）：**必須**落在下方 ReadWritePaths 之一
# （/var/lib/filet-api）。不宣告＝預設相對路徑 var/copytrade/explore_index.json，在
# ProtectSystem=strict 下落檔靜默失敗（只有一行 warning），結果是每次 API 重啟
# /explore 冷建空榜 ~12 分鐘——正式機 2026-08-31～09-02 就是這個狀態。
Environment=FILET_EXPLORE_CACHE_PATH=/var/lib/filet-api/explore_index.json
Environment=FILET_ADMIN_ADDRESSES=REPLACE_WITH_ADMIN_ADDRESSES
Environment=FILET_API_PORT=8700
# M3 計費（測試模式）：要啟用時取消註解並填 Stripe **測試** key（sk_test_ 前綴強制，
# 非測試 key 會拒啟動）。三個一起設或都不設。正式收費是人工決策（M0 律師條款未結案）。
#Environment=FILET_STRIPE_SECRET_KEY=sk_test_REPLACE
#Environment=FILET_STRIPE_WEBHOOK_SECRET=whsec_REPLACE
#Environment=FILET_STRIPE_PRICE_ID=price_REPLACE
# /contact 聯絡表單（2026-09-02，選配；2026-09-02 reviewer Critical 修正）：Gmail SMTP
# 應用程式密碼（需帳號 2FA）。USER/PASS 成對，只設一個會拒絕啟動；都不設 → 表單頁仍可
# 開、送出回 503。⚠️ 密碼**不得**走本檔或 `systemctl edit` 的行內 `Environment=`（那條路
# 落地會是 0644、`systemctl cat` 對所有帳號可讀）——改走下方 EnvironmentFile 指到的
# `/etc/filet/contact.env`（0640 root:filet-api，絕不進 repo）。申請與落地見 RUNBOOK §5.8b。
EnvironmentFile=-/etc/filet/contact.env
StateDirectory=filet-api
ExecStart=/opt/filet/spark/.venv/bin/python -m scripts.run_api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# 交換目錄列入 RW：API 是這個檔唯一的寫入者（引擎那邊刻意不列，方向單向）。
ReadWritePaths=/var/lib/filet-api /run/filet /var/lib/filet-exchange
PrivateTmp=true

[Install]
WantedBy=multi-user.target
