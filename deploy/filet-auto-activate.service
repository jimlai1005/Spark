[Unit]
Description=Filet auto-activate watcher (pending + signed leader selection -> activate & start follower)
After=network-online.target

[Service]
Type=oneshot
# ⭐ root：本 unit 是人工核可 CLI 的自動化替身（2026-07-30 使用者裁決，僅內部使用），
# 需要 systemctl start、寫 /etc/filet/followers、寫 follower manifest 與 state 目錄——
# 這些正是刻意不給 filet-api 的權限（權限拓撲不變：API 仍寫不到 manifest）。
User=root
WorkingDirectory=/opt/filet/spark
# watcher 私有狀態檔的所在（記錄哪些帳號由 watcher 啟動——區分「可重試 start」與
# 「人工停機不得復活」的唯一依據）。
StateDirectory=filet-auto-activate
Environment=FILET_BUILDER_ADDR=REPLACE_WITH_BUILDER_ADDRESS
# 白名單與其他 unit 逐字元相同（單一來源，見 filet-daily-report.service 的同款註解）。
Environment=FILET_LEADERS_PATH=/opt/filet/spark/var/filet/leaders.json
# 告警通道與 filet-daily-report 同源；檔案允許不存在（`-`）→ notifier 全靜默，
# 但啟用失敗仍會讓 unit 進 failed（journal 可查）。
EnvironmentFile=-/etc/filet/telegram.env
ExecStart=/opt/filet/spark/.venv/bin/python -m scripts.filet_auto_activate \
    --pending /var/lib/filet-api/pending.json \
    --manifest /opt/filet/spark/var/filet/followers.json \
    --exchange-dir /var/lib/filet-exchange \
    --env-template /etc/filet/follower.env.template \
    --env-dir /etc/filet/followers \
    --state-base /opt/filet/state \
    --state-file /var/lib/filet-auto-activate/state.json
# 失敗（任何一個條目啟用失敗、範本佔位符未填）→ exit 1 → unit failed，監控看得見。
NoNewPrivileges=true
PrivateTmp=true
# ⭐ 縱深防禦（2026-07-30 安全審查）：root 進程只該寫這四個路徑。程式端已改用
# fd-based 原子寫（見 spark/filet/atomic_json.py）擋掉 symlink 提權，這裡再把
# 「就算被騙也只能寫這幾處」釘死在核心層。
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/filet-api
ReadWritePaths=/var/lib/filet-exchange
ReadWritePaths=/etc/filet/followers
ReadWritePaths=/opt/filet/state
ReadWritePaths=/opt/filet/spark/var/filet

[Install]
WantedBy=multi-user.target
