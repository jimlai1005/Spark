# 自動啟用 env 範本（部署到 /etc/filet/follower.env.template，root:root 600）。
# auto-activate watcher 對每個新啟用的 follower 逐字複製本檔為
# /etc/filet/followers/<account_id>.env（640 filet-engine）；已存在的 env 不覆寫。
#
# ⚠️ 紅線 5 例外（2026-07-30 使用者裁決，產品僅內部使用）：COPY_LIVE_TRADING=true
# ——自動啟用即開實盤。對外開放前必須重審（見專案 CLAUDE.md 紅線 5 例外條款）。
#
# ⭐ watcher 對「REPLACE_WITH」殘留 fail-closed：下面兩個 TG 佔位符沒填好之前，
# 不會有任何 follower 被啟用。
#
# ⭐⭐ 本範本**不得**包含 SPARK_NETWORK / SPARK_ACCOUNT_ID / SPARK_USER_ADDR /
# SPARK_BUILDER_ADDR——這四個引擎必填變數由 watcher 逐用戶代入（network 取自
# pending 條目、帳號與位址取自結構性核對過的值）。範本裡出現任何一個 → 整輪拒跑。
#
# ⭐⭐ 自 2026-07-30 起，**下列六個鍵由 watcher 逐用戶代入**，範本不得設定
# （出現即整輪拒跑）：
#   COPY_RISK_CONTROLS_ENABLED / COPY_MAX_DRAWDOWN_PCT / COPY_MAX_TOTAL_DRAWDOWN_PCT
#   COPY_FLATTEN_ON_BREACH / COPY_RISK_COOLDOWN_HOURS / COPY_SIZE_TOLERANCE
# 它們現在是**錢包主人自己選的**（未表達＝產品預設：不啟用風控、容忍度 8%、
# 冷靜期 12 小時），單一定義點在 src/spark/filet/risk_prefs.py。
# ⚠️ 升級既有機器時必須把 COPY_MAX_DRAWDOWN_PCT 與 COPY_SIZE_TOLERANCE 兩行從
# /etc/filet/follower.env.template 刪掉，否則 watcher 會拒絕啟用任何人（見 RUNBOOK §5.6a-1）。
#
# ⭐⭐ 自 2026-07-31 起，**下列兩個 vault 鍵同為 watcher-owned**，範本不得設定
# （出現即整輪拒跑）：
#   COPY_MAX_TARGET_LEVERAGE / COPY_LEADER_FLOW_NEUTRALIZATION
# 它們只對「選了 vault leader」的 follower 注入（20x 帽＋流量中性化；引擎每輪
# 另按 leader kind 自衛）。見 RUNBOOK §5.5「vault leader 上架前置檢查」。
COPY_LIVE_TRADING=true
COPY_TG_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
COPY_TG_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID
COPY_CAPITAL_UTILIZATION=0.9
# COPY_ALLOCATED_CAPITAL 刻意不設 → use_full_equity：以全帳戶權益 × 使用率跟單。
# 要為特定用戶設本金上限：啟用後人工編輯他的 /etc/filet/followers/<id>.env ＋
# systemctl restart filet-follower@<id>（watcher 不會覆寫人工調過的檔）。
# COPY_FOLLOWER_FLOW_CORRECTION 同樣刻意不設（引擎預設 true＝follower 自身出入金
# 自動校正回撤基準，2026-07-31 第二批；一般不用設）。要為特定用戶關閉：
# 人工在他的 env 加 COPY_FOLLOWER_FLOW_CORRECTION=false ＋ restart（同上）。
