[Unit]
Description=Filet copytrade follower (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=filet-engine
Group=filet-engine
EnvironmentFile=/etc/filet/followers/%i.env
WorkingDirectory=/opt/filet/spark
# 每 follower 獨立狀態根（修 kill-switch 連坐）
Environment=FILET_STATE_DIR=/opt/filet/state/%i
Environment=FILET_KEYSTORE=envfile
Environment=FILET_KEYS_DIR=/etc/filet/keys
# ⭐ leader 白名單：顯式絕對路徑，不倚賴 WorkingDirectory。管理端跑 activate CLI 的
# CWD 與引擎的 CWD 不同，兩邊驗不同檔＝下架在一邊生效、引擎那邊仍放行（fail-open）。
# 這份檔必須是 root:root 644（filet-api 寫不到）——見 RUNBOOK §5.5。
Environment=FILET_LEADERS_PATH=/opt/filet/spark/var/filet/leaders.json
Environment=FILET_FOLLOWERS=/opt/filet/spark/var/filet/followers.json
# ⭐ 客戶簽章換 leader／資金設定記錄的交換目錄。必須與 filet-api.service 的同名變數
# 逐字元相同；漏設會讓引擎拒絕啟動（require_exchange_dir，刻意無預設值——舊版的隱含
# 預設讓 API 寫 /var/lib/filet-api、引擎讀 repo 內的 var/filet，功能完全不通而兩邊
# log 都正常）。
# ⚠️ 目錄**根**刻意不列入 ReadWritePaths：那一層是 api→engine 單向（API 寫、引擎讀），
# 被打穿的引擎因此改寫不了客戶簽章記錄。引擎唯一能寫的是底下的 engine/ 子目錄
# （engine→api 單向，健康心跳落點，見下方 ReadWritePaths 與 RUNBOOK §5.5.1）。
Environment=FILET_EXCHANGE_DIR=/var/lib/filet-exchange
ExecStart=/opt/filet/spark/.venv/bin/python -m scripts.run_copytrade
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# 引擎只讀 agent key（/etc/filet/keys 於 ProtectSystem=strict 下本就唯讀，不列入 RW）；
# 需要寫入的只有兩處：
#   1. 自己的狀態根。
#   2. ⭐ 交換目錄底下的 engine/ 子通道（健康心跳落點）。**只有這個子目錄，不是整個
#      交換目錄**：面板要的是幾個摘要值，而放寬整個交換目錄會讓被打穿的引擎能改寫
#      客戶簽章的換 leader／資金設定記錄。目錄本身由 RUNBOOK §5.5.1 人工建立
#      （filet-engine:filet-api 0750）——引擎對交換目錄根無寫權，建不出它，這是刻意的：
#      「引擎能寫什麼」是部署決定，不是引擎自己決定的事。
ReadWritePaths=/opt/filet/state/%i /var/lib/filet-exchange/engine
PrivateTmp=true

[Install]
WantedBy=multi-user.target
